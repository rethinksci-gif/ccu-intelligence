---
import Base from '../../layouts/Base.astro';
import ReadingContents from '../../components/ReadingContents.astro';
import { getCollection, render } from 'astro:content';
import { href } from '../../lib/data';
export async function getStaticPaths() {
  return (await getCollection('learning')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
---

<Base title={entry.data.title} description={entry.data.description}
  ><div class="prose-title" id="article-top">
    <p class="eyebrow"><a href={href('learning/')}>Insights & learning</a> / {entry.data.category}</p><h1>
      {entry.data.title}
    </h1><p>{entry.data.description}</p><p class="meta">
      Technical reference · Updated {entry.data.updated.toISOString().slice(0, 10)}
    </p>
  </div><div class="issue-layout">
    <ReadingContents
      sections={sections}
      label="Article contents"
      title="On this page"
      topId="article-top"
    /><article class="prose issue-body"><Content /></article>
  </div></Base
>
