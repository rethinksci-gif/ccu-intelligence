---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const issue = (await getCollection('issues', ({ data }) => data.sample))[0];
const { Content } = await render(issue);
---

<Base title="Sample issue — fictional editorial demonstration" noindex
  ><div class="prose-title">
    <p class="eyebrow">Editorial demonstration</p><h1>Sample biweekly issue</h1><p>
      Fictional examples · Not published · Excluded from RSS
    </p><div class="notice">
      This is an incomplete editorial draft showing the issue format. Project news and references to
      example.org are fictional. It is not a verified current briefing.
    </div>
  </div><article class="prose"><Content /></article></Base
>
