---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { publicIssues, readingMinutes, coverageLabel } from '../lib/issues';
import { projects, articles, technologies, href, label } from '../lib/data';
const issues = await publicIssues();
const latest = issues[0];
const latestHeadings = latest ? (await render(latest)).headings.filter((h) => h.depth === 2).slice(0, 6) : [];
const live = articles.filter((a) => !a.sample && a.editorial_status === 'reviewed' && !a.review_required);
const signals = live.slice(0, 3);
const liveProjects = projects.filter((p) => !p.sample);
const watchProjects = liveProjects.slice(0, 3);
---

<Base title="Industrial progress, in perspective">
  <div class="edition-line">
    <p class="eyebrow">The intelligence brief</p><p class="meta">
      English · Every two weeks · Evidence first
    </p>
  </div>
  <div class="page-head overview-head">
    <h1>Industrial progress,<br /><em>in perspective.</em></h1><div class="overview-intro">
      <p>
        Which carbon capture and utilization pathways are moving toward industrial viability—and what is
        preventing others from scaling?
      </p><a class="text-link" href={href('methodology/')}
        >How we assess the evidence <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  {
    !latest && (
      <div class="notice">
        <strong>Initial research edition.</strong> The first newsletter is awaiting editorial review. Project
        records link to primary sources; company and consortium reporting is attributed. Learning articles and
        calculations are reference material.
      </div>
    )
  }
  <div class="hero-grid">
    <section class="lead-card">
      <p class="eyebrow">
        {
          latest
            ? `Issue ${latest.data.issue_number}${latest.data.editorial_status === 'research_published' ? ' · Research edition' : ''}`
            : 'Biweekly briefing · editorial review pending'
        }
      </p><h2>{latest ? latest.data.title : 'From promising chemistry to a working industrial system.'}</h2><p
      >
        Connect scientific progress to engineering constraints, project execution, production costs and
        climate performance.
      </p>
      {
        latest && (
          <p class="meta">
            Coverage: {coverageLabel(latest.data.coverage_start, latest.data.coverage_end)}
            <br />
            {latest.data.source_count} sources · About {readingMinutes(latest.body)} min read
          </p>
        )
      }
      <a class="button" href={latest ? href(`issues/${latest.id}/`) : href('projects/')}
        >{latest ? 'Read the latest issue' : 'Explore sourced projects'}</a
      >
    </section>
    <section class="card focus-card">
      <p class="eyebrow">Technology in focus</p><h2>CO₂ → Methanol</h2><p>
        A simple reaction. A demanding industrial balance.
      </p><div
        class="pathway-visual"
        aria-label="Carbon dioxide and hydrogen are converted to methanol and water"
      >
        <div class="pathway-inputs">
          <span>CO₂<small>Carbon feedstock</small></span><span>3 H₂<small>Hydrogen supply</small></span>
        </div>
        <div class="pathway-connector" aria-hidden="true"><span></span>↓<span></span></div>
        <div class="pathway-output">CH₃OH <span>+ H₂O</span><small>Methanol + water</small></div>
      </div><p>Inspect stoichiometry, hydrogen costs and the limits of a partial cost model.</p><a
        href={href('technologies/co2-to-methanol/')}>Open the pathway & calculator</a
      ><p class="meta rule">Reference material · No pathway-wide TRL assigned</p>
    </section>
  </div>
  <nav class="overview-stats" aria-label="Explore the intelligence library">
    <a href={href('projects/')}
      ><strong>{String(liveProjects.length).padStart(2, '0')}</strong><span
        >Tracked projects<small>Primary-source records</small></span
      ><span aria-hidden="true">↗</span></a
    >
    <a href={href('technologies/')}
      ><strong>{String(technologies.length).padStart(2, '0')}</strong><span
        >Technology pathways<small>From capture to conversion</small></span
      ><span aria-hidden="true">↗</span></a
    >
    <a href={href('issues/')}
      ><strong>{String(issues.length).padStart(2, '0')}</strong><span
        >Published issues<small>A biweekly perspective</small></span
      ><span aria-hidden="true">↗</span></a
    >
  </nav>
  {
    live.length > 0 ? (
      <>
        <div class="section-head">
          <>
            <h2>Executive signals</h2>
            <span class="badge">Reviewed evidence</span>
          </>
        </div>
        <div class="cards">
          {signals.map((a, i) => (
            <article class="card">
              <span class="card-index">0{i + 1} / INDUSTRIAL READINESS</span>
              <h3>{a.title.replace('Sample: ', '')}</h3>
              <p>{a.industrial_implications}</p>
              <p class="meta">Uncertainty: {a.uncertainty}</p>
              <a href={href('issues/')}>Read the context</a>
            </article>
          ))}
        </div>
        <div class="section-head">
          <>
            <h2>Recent industry developments</h2>
            <a href={href('issues/')}>Newsletter archive</a>
          </>
        </div>
        <ul class="list-clean card">
          {live.slice(0, 6).map((a) => (
            <li>
              <a href={a.canonical_url}>{a.title}</a>
              <p class="meta">
                Published {a.publication_date} · {a.domains.join(', ')}
              </p>
              <p>{a.summary}</p>
            </li>
          ))}
        </ul>
      </>
    ) : latest ? (
      <section aria-labelledby="inside-issue">
        <div class="section-head">
          <>
            <h2 id="inside-issue">Inside the latest issue</h2>
            <a href={href('issues/')}>All issues</a>
          </>
        </div>
        <p class="muted">
          {latest.data.editorial_status === 'research_published'
            ? 'Research edition. Source limitations and outstanding review notes are included in the issue.'
            : 'Explore the analysis, sources and project developments in this issue.'}
        </p>
        <div class="cards issue-sections">
          {latestHeadings.map((heading, i) => (
            <a class="card" href={href(`issues/${latest.id}/#${heading.slug}`)}>
              <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{heading.text}</h3>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    ) : null
  }
  <div class="section-head"><h2>Project watch</h2><a href={href('projects/')}>Explore the tracker</a></div>
  <div class="table-wrap project-watch">
    <table role="table">
      <caption
        >{
          liveProjects.length
            ? 'Primary-source project records · reported status, not audited throughput'
            : 'Sample project updates · fictional, not verified commercial records'
        }</caption
      ><thead role="rowgroup"
        ><tr role="row"
          ><th role="columnheader" scope="col">Project</th><th role="columnheader" scope="col">Region</th><th
            role="columnheader"
            scope="col">Status</th
          ><th role="columnheader" scope="col">Evidence limitation</th></tr
        ></thead
      ><tbody role="rowgroup"
        >{
          watchProjects.map((p) => (
            <tr role="row">
              <>
                <td role="cell">
                  <>
                    <a href={href(`projects/${p.project_id}/`)}>{p.project_name}</a>
                    <span class="meta">{p.conversion_pathway}</span>
                  </>
                </td>
                <td role="cell" data-label="Region">
                  {p.region}
                </td>
                <td role="cell" data-label="Status">
                  <span class="badge status">{label(p.development_status)}</span>
                </td>
                <td role="cell" data-label="Evidence limitation">
                  {p.sample ? 'Fictional sample; no live verification' : p.limitations}
                </td>
              </>
            </tr>
          ))
        }</tbody
      >
    </table>
  </div>
  <div class="section-head">
    <h2>Build a stronger technical lens</h2><a href={href('learning/')}>All insights & learning</a>
  </div>
  <div class="cards">
    <article class="card">
      <p class="eyebrow">Carbon accounting</p><h3>Utilization is not removal</h3><p>
        Distinguish fossil substitution, temporary carbon use and durable atmospheric carbon removal.
      </p><a href={href('learning/ccu-ccs-cdr/')}>Read the primer</a>
    </article><article class="card">
      <p class="eyebrow">Industrial evidence</p><h3>Read beyond the TRL</h3><p>
        Ask what was tested, for how long, at what scale, and in which operating environment.
      </p><a href={href('learning/trl/')}>Assess readiness</a>
    </article><article class="card">
      <p class="eyebrow">Economic discipline</p><h3>Interrogate the boundary</h3><p>
        A feedstock subtotal is not a levelized production cost or a minimum selling price.
      </p><a href={href('learning/tea/')}>Understand the comparison</a>
    </article>
  </div>
</Base>
