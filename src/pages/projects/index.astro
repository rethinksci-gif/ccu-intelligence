---
import Base from '../../layouts/Base.astro';
import { projects, companyName, href, quantity, label } from '../../lib/data';
const options = (key: keyof (typeof projects)[number]) =>
  [...new Set(projects.map((p) => String(p[key] ?? 'Unknown')))].sort();
const facets = [
  ['region', 'Region'],
  ['country', 'Country'],
  ['company', 'Company'],
  ['conversion_pathway', 'Pathway'],
  ['primary_product', 'Product'],
  ['development_status', 'Status'],
  ['technology_trl', 'TRL'],
  ['confidence_level', 'Evidence confidence'],
] as const;
const capacityKeys = [
  ...new Set(
    projects.flatMap((p) =>
      p.announced_capacity
        ? [`${p.announced_capacity.basis}|${p.announced_capacity.substance}|${p.announced_capacity.unit}`]
        : [],
    ),
  ),
];
---

<Base title="Project tracker">
  <div class="page-head">
    <p class="eyebrow">Industry database</p><h1>Project tracker</h1><p>
      Follow the distance between announcement and operation. Compare capacity only when the product, unit and
      measurement basis match.
    </p>
  </div>
  <div class="notice">
    <strong>Data scope.</strong>
    Records are checked against linked primary sources. Company and consortium reports remain attributed; design
    capacity is not actual production. Verification dates record source checks, not plant audits.
  </div>
  <div class="statline">
    <div>
      <strong>{projects.filter((p) => !p.sample).length}</strong><span>Sourced project records</span>
    </div><div>
      <strong>{projects.filter((p) => p.operational_capacity).length}</strong><span
        >Measured output records</span
      >
    </div><div>
      <strong>{new Set(projects.map((p) => p.country)).size}</strong><span>Countries covered</span>
    </div><div>
      <strong>—</strong><span>Aggregate capacity intentionally omitted</span>
    </div>
  </div>
  <div class="section-head">
    <h2>Explore project records</h2><a href={href('data/intelligence.json')}>Download curated JSON</a>
  </div>
  <form id="project-filters" class="filters" role="search" aria-label="Filter projects">
    <label class="wide"
      >Search projects<input type="search" name="query" placeholder="Project, company, product…" /></label
    >
    <label
      >Data scope<select name="scope"
        ><option value="all">All sourced records</option><option value="live">Live records only</option
        ><option value="sample">Samples only</option></select
      ></label
    >
    {
      facets.map(([key, name]) => (
        <label>
          {name}
          <select name={key}>
            <option value="">All {name.toLowerCase()}</option>
            {options(key).map((v) => (
              <option value={v}>
                {key === 'company' ? companyName(v) : key === 'development_status' ? label(v) : v}
              </option>
            ))}
          </select>
        </label>
      ))
    }
    <label
      >Comparable capacity group<select name="capacityGroup"
        ><option value="">Choose basis / product / unit</option>{
          capacityKeys.map((k) => <option value={k}>{k.replaceAll('|', ' · ').replaceAll('_', ' ')}</option>)
        }</select
      ></label
    >
    <label
      >Minimum announced capacity<input
        type="number"
        name="minCapacity"
        min="0"
        placeholder="Choose a group first"
        disabled
      /></label
    >
    <label
      >Data availability<select name="availability">
        <option value="">All records</option>
        <option value="output">Operational capacity reported</option>
        <option value="no-output">Operational capacity not reported</option>
        <option value="capacity">Announced capacity reported</option>
        <option value="no-capacity">Announced capacity not reported</option>
        <option value="lca">LCA evidence linked</option>
        <option value="no-lca">No linked LCA evidence</option>
      </select></label
    >
    <label>Source checked on or after<input type="date" name="verifiedSince" /></label>
    <label
      >Sort by<select name="sort">
        <option value="">Default order</option>
        <option value="name">Project name A–Z</option>
        <option value="verified">Most recently checked</option>
        <option value="capacity" disabled>Announced capacity: high to low (choose group)</option>
      </select></label
    >
    <button type="reset" class="button">Reset filters</button>
  </form>
  <div class="row project-tools">
    <p class="meta" id="project-count" role="status">{projects.length} projects shown</p>
    <button type="button" class="button" id="export-projects" hidden>Download filtered JSON</button>
  </div>
  <div class="table-wrap">
    <table id="projects-table">
      <thead
        ><tr
          ><th scope="col">Project / company</th><th scope="col">Region / pathway</th><th scope="col"
            >Status / TRL</th
          ><th scope="col">Announced capacity</th><th scope="col">Operational capacity</th><th scope="col"
            >Evidence / source check</th
          ></tr
        ></thead
      ><tbody
        >{
          projects.map((p) => (
            <tr data-project={JSON.stringify({ ...p, company_name: companyName(p.company) })}>
              <>
                <td>
                  <a href={href(`projects/${p.project_id}/`)}>{p.project_name}</a>
                  <span class="meta">{companyName(p.company)}</span>
                  {p.sample && <span class="badge sample">Fictional sample</span>}
                </td>
                <td>
                  {p.region}
                  <span class="meta">
                    {p.country} · {p.conversion_pathway}
                  </span>
                </td>
                <td>
                  <>
                    <span class="badge status">{label(p.development_status)}</span>
                    <span class="meta">TRL {p.technology_trl ?? 'not reported'}</span>
                  </>
                </td>
                <td class="capacity">{quantity(p.announced_capacity)}</td>
                <td class="capacity">{quantity(p.operational_capacity)}</td>
                <td>
                  <>
                    <span class="badge">{p.confidence_level} confidence</span>
                    <span class="meta">
                      Source checked: {p.date_last_verified ?? 'Not reported'}
                      <br />
                      {p.sources.length} linked sources ·{' '}
                      {p.lca_evidence.length ? 'LCA evidence linked' : 'No linked LCA evidence'}
                    </span>
                  </>
                </td>
              </>
            </tr>
          ))
        }</tbody
      >
    </table>
  </div>
  <p id="project-empty" class="empty" hidden>
    No projects match these filters. Try another selection or reset the filters.
  </p>
  <noscript
    ><p>
      All records are shown. Enable JavaScript for filters; project detail links work without it.
    </p></noscript
  >
</Base>
<script>
  import { searchText } from '../../lib/project-search';
  import type { projects } from '../../lib/data';
  type Project = (typeof projects)[number] & { company_name: string };
  const form = document.querySelector<HTMLFormElement>('#project-filters');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-project]')].map((row) => ({
    row,
    project: JSON.parse(row.dataset.project!) as Project,
  }));
  const fields = [
    'region',
    'country',
    'company',
    'conversion_pathway',
    'primary_product',
    'development_status',
    'technology_trl',
    'confidence_level',
  ] as const;
  const controls = form
    ? [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name], select[name]')]
    : [];
  function restoreFilters() {
    form?.reset();
    const params = new URL(window.location.href).searchParams;
    for (const control of controls) {
      const value = params.get(control.name);
      if (value === null) continue;
      if (control instanceof HTMLSelectElement && ![...control.options].some((o) => o.value === value))
        continue;
      control.value = value;
      if (control instanceof HTMLInputElement && !control.validity.valid) control.value = '';
    }
    filter();
  }
  function saveFilters() {
    const url = new URL(window.location.href);
    for (const control of controls) {
      url.searchParams.delete(control.name);
      if (!control.disabled && control.value && !(control.name === 'scope' && control.value === 'all'))
        url.searchParams.set(control.name, control.value);
    }
    window.history.replaceState(window.history.state, '', url);
  }
  function filter() {
    if (!form) return;
    const data = new FormData(form),
      query = searchText(String(data.get('query') ?? '').trim()),
      group = String(data.get('capacityGroup') ?? '');
    const minimum = form.elements.namedItem('minCapacity') as HTMLInputElement;
    minimum.disabled = !group;
    if (!group) minimum.value = '';
    const sort = form.elements.namedItem('sort') as HTMLSelectElement;
    sort.querySelector<HTMLOptionElement>('[value="capacity"]')!.disabled = !group;
    if (!group && sort.value === 'capacity') sort.value = '';
    const terms = query.split(/\s+/).filter(Boolean);
    const availability = String(data.get('availability') ?? '');
    const verifiedSince = String(data.get('verifiedSince') ?? '');
    let count = 0;
    for (const { row, project: p } of rows) {
      const capacity = p.announced_capacity;
      const matches =
        terms.every((term) =>
          searchText(
            [
              p.project_name,
              p.company_name,
              p.country,
              p.region,
              p.location,
              p.primary_product,
              p.conversion_pathway,
              p.co2_source,
            ].join(' '),
          ).includes(term),
        ) &&
        (!verifiedSince || (!!p.date_last_verified && p.date_last_verified >= verifiedSince)) &&
        (!availability ||
          (
            {
              output: !!p.operational_capacity,
              'no-output': !p.operational_capacity,
              capacity: !!p.announced_capacity,
              'no-capacity': !p.announced_capacity,
              lca: p.lca_evidence.length > 0,
              'no-lca': p.lca_evidence.length === 0,
            } as Record<string, boolean>
          )[availability]) &&
        fields.every((k) => !data.get(k) || String(p[k] ?? 'Unknown') === data.get(k)) &&
        (data.get('scope') !== 'live' || !p.sample) &&
        (data.get('scope') !== 'sample' || p.sample) &&
        (!group ||
          (capacity &&
            `${capacity.basis}|${capacity.substance}|${capacity.unit}` === group &&
            capacity.value >= Number(minimum.value || 0)));
      row.hidden = !matches;
      if (matches) count++;
    }
    const ordered = [...rows];
    if (sort.value)
      ordered.sort((a, b) => {
        let result = 0;
        if (sort.value === 'name')
          result = searchText(a.project.project_name).localeCompare(searchText(b.project.project_name));
        if (sort.value === 'verified')
          result = (b.project.date_last_verified ?? '').localeCompare(a.project.date_last_verified ?? '');
        if (sort.value === 'capacity')
          result = (b.project.announced_capacity?.value ?? -1) - (a.project.announced_capacity?.value ?? -1);
        return result || a.project.project_id.localeCompare(b.project.project_id);
      });
    const tbody = document.querySelector('#projects-table tbody')!;
    ordered.forEach(({ row }) => tbody.append(row));
    const download = document.querySelector<HTMLButtonElement>('#export-projects')!;
    download.hidden = false;
    download.disabled = count === 0;
    document.querySelector('#project-count')!.textContent = `${count} project${count === 1 ? '' : 's'} shown`;
    (document.querySelector('#project-empty') as HTMLElement).hidden = count !== 0;
  }
  function updateFilters() {
    filter();
    saveFilters();
  }
  document.querySelector('#export-projects')?.addEventListener('click', () => {
    const visible = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-project]')]
      .filter((row) => !row.hidden)
      .map((row) => JSON.parse(row.dataset.project!));
    const result = {
      exported_at: new Date().toISOString(),
      filters: Object.fromEntries(new FormData(form!)),
      projects: visible,
    };
    const url = URL.createObjectURL(
      new Blob([JSON.stringify(result, null, 2)], { type: 'application/json' }),
    );
    const link = document.createElement('a');
    link.href = url;
    link.download = 'ccu-projects-filtered.json';
    link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
  form?.addEventListener('input', updateFilters);
  form?.addEventListener('change', updateFilters);
  form?.addEventListener('reset', () => setTimeout(updateFilters, 0));
  form?.addEventListener('submit', (e) => e.preventDefault());
  window.addEventListener('popstate', restoreFilters);
  restoreFilters();
</script>
