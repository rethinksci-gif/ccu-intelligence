---
import Base from '../../layouts/Base.astro';
import { publicIssues, readingMinutes, coverageLabel } from '../../lib/issues';
import { href } from '../../lib/data';
const issues = await publicIssues();
const topics = [...new Set(issues.flatMap((i) => i.data.featured_topics))];
---

<Base title="Biweekly issues"
  ><div class="page-head">
    <p class="eyebrow">The newsletter archive</p><h1>Two weeks. The signals that matter.</h1><p>
      Concise technical and industrial analysis, with citations, uncertainty and a clear boundary between
      announcements and demonstrated progress.
    </p>
  </div>
  <form class="filters" id="issue-search" role="search" aria-label="Search issues">
    <label class="wide"
      >Search the archive<input name="query" type="search" placeholder="Search titles and topics" /></label
    ><label
      >Topic<select name="topic"
        ><option value="">All topics</option>{topics.map((t) => <option>{t}</option>)}</select
      ></label
    ><button class="button" type="reset">Reset</button>
  </form>
  <p id="issue-count" role="status" class="meta">
    {issues.length} published {issues.length === 1 ? 'issue' : 'issues'}
  </p><div id="issue-results">
    {
      issues.map((i) => (
        <article
          class="card issue-card"
          data-search={`${i.data.issue_number} ${i.data.title} ${i.data.featured_topics.join(' ')}`.toLowerCase()}
          data-topics={JSON.stringify(i.data.featured_topics)}
        >
          <>
            <div class="issue-number">{String(i.data.issue_number).padStart(2, '0')}</div>
            <div>
              <>
                <p class="meta">
                  {i.data.publication_date!.toISOString().slice(0, 10)} · {i.data.source_count} sources
                  {i.data.editorial_status === 'research_published' && ' · Research edition'}
                </p>
                <h2>
                  <a class="title-link" href={href(`issues/${i.id}/`)}>
                    {i.data.title}
                  </a>
                </h2>
                <p>{i.data.featured_topics.join(' · ')}</p>
                <p class="meta">
                  Coverage: {coverageLabel(i.data.coverage_start, i.data.coverage_end)} · About{' '}
                  {readingMinutes(i.body)} min read
                </p>
              </>
            </div>
          </>
        </article>
      ))
    }
  </div>
  <p id="issue-empty" class="empty" hidden={issues.length > 0}>
    {
      issues.length
        ? 'No issues match your search. Try another term or reset the filters.'
        : 'No published issues yet. Check back for the first edition.'
    }
  </p>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('#issue-search');
  const query = form?.querySelector<HTMLInputElement>('[name="query"]');
  const topic = form?.querySelector<HTMLSelectElement>('[name="topic"]');
  function restore() {
    const params = new URLSearchParams(location.search);
    if (query) query.value = params.get('q') || '';
    if (topic)
      topic.value = [...topic.options].some((o) => o.value === params.get('topic'))
        ? params.get('topic')!
        : '';
    filter(false);
  }
  function filter(updateURL = true) {
    if (!form) return;
    const data = new FormData(form);
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-search]').forEach((card) => {
      const shown =
        card.dataset.search!.includes(String(data.get('query')).trim().toLowerCase()) &&
        (!data.get('topic') || JSON.parse(card.dataset.topics!).includes(data.get('topic')));
      card.hidden = !shown;
      if (shown) count++;
    });
    document.querySelector('#issue-count')!.textContent =
      `${count} published ${count === 1 ? 'issue' : 'issues'} shown`;
    (document.querySelector('#issue-empty') as HTMLElement).hidden = count > 0;
    if (updateURL) {
      const url = new URL(location.href);
      for (const [key, value] of [
        ['q', query?.value.trim()],
        ['topic', topic?.value],
      ]) {
        if (value) url.searchParams.set(key!, value);
        else url.searchParams.delete(key!);
      }
      history.replaceState(null, '', url);
    }
  }
  form?.addEventListener('input', () => filter());
  form?.addEventListener('submit', (e) => e.preventDefault());
  form?.addEventListener('reset', () => setTimeout(() => filter(), 0));
  window.addEventListener('popstate', restore);
  restore();
</script>
