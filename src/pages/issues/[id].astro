---
import Base from '../../layouts/Base.astro';
import ReadingContents from '../../components/ReadingContents.astro';
import { render } from 'astro:content';
import { href } from '../../lib/data';
import { publicIssues, readingMinutes, coverageLabel } from '../../lib/issues';
export async function getStaticPaths() {
  const issues = (await publicIssues()).reverse();
  return issues.map((issue, i) => ({
    params: { id: issue.id },
    props: { issue, previous: issues[i - 1]?.id, next: issues[i + 1]?.id },
  }));
}
const { issue, previous, next } = Astro.props;
const { Content, headings } = await render(issue);
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={issue.data.title}
  ><div class="prose-title" id="issue-top">
    <a class="meta" href={href('issues/')}>← Newsletter archive</a>
    <p class="eyebrow">
      Issue {issue.data.issue_number} · {issue.data.publication_date!.toISOString().slice(0, 10)}
    </p><h1>{issue.data.title}</h1><p class="meta">
      {issue.data.source_count} sources · {
        issue.data.editorial_status === 'research_published'
          ? 'Research edition · Full editorial review incomplete'
          : `Reviewed by ${issue.data.reviewer}`
      }
    </p>
    <p class="meta">
      Coverage: {coverageLabel(issue.data.coverage_start, issue.data.coverage_end)} · About {
        readingMinutes(issue.body)
      } min read
    </p>
  </div>
  <div class="issue-layout">
    <ReadingContents sections={sections} label="Issue contents" title="In this issue" topId="issue-top" />
    <article class="prose issue-body"><Content /></article>
  </div><nav class="row rule" aria-label="Issue navigation">
    {previous && <a href={href(`issues/${previous}/`)}>Previous issue</a>}<a href={href('issues/')}
      >All issues</a
    >{next && <a href={href(`issues/${next}/`)}>Next issue</a>}
  </nav></Base
>
